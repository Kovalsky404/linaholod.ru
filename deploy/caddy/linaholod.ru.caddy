# Блок для /etc/caddy/Caddyfile — ДОПИСАТЬ в конец, ничего не удаляя.
# Соседний проект (siberianwellness-tj.ru) остаётся как есть.
#
# Caddy сам получает сертификат Let's Encrypt и продлевает его — certbot не
# нужен. Но для выпуска DNS домена уже должен указывать на этот сервер.
#
# Применить:  sudo systemctl reload caddy
# Проверить:  sudo caddy validate --config /etc/caddy/Caddyfile

linaholod.ru {
	encode zstd gzip

	# Имена файлов Next содержат хеш сборки, поэтому их можно кешировать
	# навсегда. /images и /videos — статика из public.
	@static path /_next/static/* /images/* /videos/* /fonts/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3001
}

# Адрес с www ведёт на основной, чтобы поисковики видели один сайт, а не два
www.linaholod.ru {
	redir https://linaholod.ru{uri} permanent
}

# ── Второй домен ────────────────────────────────────────────────────────
# holodlina.ru ВРЕМЕННО отдаёт тот же сайт, а не редиректит на основной.
# Причина: его DNS уже указывает сюда, а linaholod.ru ещё на Vercel и пока
# не проверено, что после переезда он вообще откроется из РФ (блокировка
# шла по SNI). Редирект сейчас увёл бы единственный рабочий домен на
# недоступный адрес.
#
# КОГДА linaholod.ru переедет и откроется без VPN — заменить содержимое
# этого блока на одну строку:
#     redir https://linaholod.ru{uri} permanent
# Тогда поисковики склеят домены в один, а не сочтут их двумя сайтами с
# одинаковым содержимым.
holodlina.ru, www.holodlina.ru {
	encode zstd gzip

	@static path /_next/static/* /images/* /videos/* /fonts/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3001
}
